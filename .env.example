# ProcureAgent Environment Configuration (100% Free Stack)

# FastAPI
PROJECT_NAME="ProcureAgent"
API_V1_STR="/api/v1"
SECRET_KEY="procureagent-super-secret-key-change-in-production"

# LLM Providers (100% Free Tier Options)
# Primary: Groq API (Get free API key at https://console.groq.com)
GROQ_API_KEY="GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXX"
DEFAULT_GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini (Get free API key at https://aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"
DEFAULT_GEMINI_MODEL="gemini-1.5-flash"

# Local Ollama Fallback (http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_OLLAMA_MODEL="llama3.1:8b"

# Databases (Local Docker Containers)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="procure_user"
POSTGRES_PASSWORD="procure_password"
POSTGRES_DB="procureagent_db"
DATABASE_URL="postgresql+asyncpg://procure_user:procure_password@localhost:5432/procureagent_db"  

REDIS_URL="redis://localhost:6379/0"
QDRANT_URL="http://localhost:6333"

# Telemetry & Observability
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:4317"
ENABLE_TELEMETRY=true
PS C:\ML_projects\Agentic ai> 
