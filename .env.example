
# ProcureOS Environment Configuration
# Copy this file to .env for local development.
# Never commit real API keys or production secrets.

PROJECT_NAME=ProcureOS
API_V1_STR=/api/v1

# Security: replace with a strong, randomly generated secret.
SECRET_KEY=replace-with-a-strong-random-secret

# LLM providers
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-1.5-flash

# Local Ollama (not automatically available on cloud hosting)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.1:8b

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://procure_user:procure_password@localhost:5432/procureagent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Frontend CORS origin
FRONTEND_URL=http://localhost:5173

# Telemetry
ENABLE_TELEMETRY=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
